# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT Auth (dashboard marchand + admin) ──────────────────
JWT_SECRET=changeme_minimum_32_chars_random_string

# ── Admin — espace Yacine ───────────────────────────────────
# Mot de passe global pour accéder à admin.winwincard.fr
# Choisir un mot de passe fort (min 16 chars recommandé)
ADMIN_PASSWORD=changeme_mot_de_passe_admin_fort

# ── Apple Wallet — pass signing ─────────────────────────────
APPLE_PASS_TYPE_IDENTIFIER=pass.com.winwincard.loyalty
APPLE_TEAM_ID=LTW34ARCX2
APPLE_PASS_PHRASE=mot_de_passe_certificat
# Chemins vers les certificats (ou contenu base64 en prod Railway)
APPLE_SIGNER_CERT=./certs/signerCert.pem
APPLE_SIGNER_KEY=./certs/signerKey.pem
APPLE_WWDR_CERT=./certs/wwdr.pem

# ── Apple Wallet — APNs push notifications ───────────────────
# Key ID : 10 chars visible dans le nom de fichier AuthKey_XXXXXXXXXX.p8
#          ou dans Apple Developer → Certificates, Identifiers & Profiles → Keys
APPLE_APN_KEY_ID=XXXXXXXXXX
# Dev : copier AuthKey_XXXXXXXXXX.p8 dans certs/apn.p8 (gitignored)
APPLE_APN_KEY=./certs/apn.p8
# Prod Railway : cat certs/apn.p8 | base64 | tr -d '\n'
# APPLE_APN_KEY_B64=

# ── Google Wallet ────────────────────────────────────────────
# Coller le contenu du fichier JSON service account sur une seule ligne
# ou utiliser: export GOOGLE_SERVICE_ACCOUNT_JSON=$(cat service-account.json)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_WALLET_ISSUER_ID=3388000000022XXXXXXX

# ── URLs publiques ───────────────────────────────────────────
API_BASE_URL=https://api.winwincard.fr
LANDING_BASE_URL=https://winwincard.fr/l

# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
